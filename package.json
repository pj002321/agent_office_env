{
  "name": "agent-office",
  "version": "0.2.3",
  "private": true,
  "description": "A cozy 3D office where your own AI coding CLIs work, one floor per project",
  "author": "JaeseongHeo",
  "license": "MIT",
  "main": "app/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs test/*.test.mjs",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "io.github.pj002321.agentoffice",
    "productName": "Cozy Office",
    "files": [
      "app/**",
      "web/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "artifactName": "AgentOffice-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": {
        "target": "dmg",
        "arch": "universal"
      },
      "category": "public.app-category.developer-tools",
      "artifactName": "AgentOffice-mac.${ext}"
    },
    "publish": { "provider": "github", "owner": "pj002321", "repo": "agent_office_env" }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@fontsource/gowun-dodum": "^5.3.0",
    "@fontsource/jua": "^5.3.0",
    "electron-updater": "^6.8.11",
    "three": "^0.170.0"
  }
}
